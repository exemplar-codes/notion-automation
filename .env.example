# Only NOTION_API_KEY comes from the global environment (~/.env).
# Do not copy credentials into this file. All IDs/settings below are project-local.
# Resolve missing database/data-source IDs using Notion MCP.

# Database container IDs: health check and legacy migrations.
ACTIVITIES_DATABASE_ID=''
CONTENT_DATABASE_ID=''
# Data source IDs: findings migration (these differ from database IDs).
# Retrieve each database with Notion API 2026-03-11 to find data_sources[].id.
ACTIVITIES_DATA_SOURCE_ID=''
CONTENT_DATA_SOURCE_ID=''
# Optional legacy override for older scripts / lib.js:
DATABASE_ID=''
RATE_LIMITING_INTERVAL=500
ROW_LIMIT='5' # blank / omit for full run

# Maximum findings processed concurrently within one activity (also caps in-flight API calls).
FINDINGS_CONCURRENCY=5
