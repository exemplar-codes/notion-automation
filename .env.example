# Prefer shell env from ~/.zshrc / ~/.env (source those first).
# Local .env is optional for overrides when running via --env-file=.env
NOTION_API_TOKEN='secret_somevalue'
# Also accepted: NOTION_TOKEN / NOTION_API_KEY

DATABASE_ID='someValue' # SAFE
# DATABASE_ID="someValue" # DANGER
RATE_LIMITING_INTERVAL=500
ROW_LIMIT='5' # blank / omit for full run
